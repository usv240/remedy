# Copy this file to .env.local and fill in the values. Never commit .env.local.
# Every service except Postgres is optional: without its key, each one uses a fallback and /status says so.

# Public URL of the app (links in notices, metadata, printed examples)
APP_URL=

# Postgres (local: docker compose up -d, then npm run db:migrate; Render: the managed connection string)
DATABASE_URL=postgres://remedy:remedy@localhost:5432/remedy

# Salt for hashing visitor addresses and contact details. Any long random string; set one in production.
AUDIT_SALT=
# Encrypts contact details at rest (src/lib/secure.ts). Any long random string; required in production.
DATA_KEY=

# Anthropic (console.anthropic.com > API keys): proof rules, photo checks and the two reviewers
ANTHROPIC_API_KEY=
# Local runs only: replay identical Claude requests from this folder instead of paying again. Never set when hosted.
AI_CACHE_DIR=.ai-cache
# Daily Claude budget in US dollars. Default 2 when hosted (RENDER is set), no limit locally. Past it, photo checks
# go to a person at the firm.
AI_DAILY_USD=

# PayPal sandbox (developer.paypal.com > Apps & Credentials > Sandbox > your app). Sandbox only.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# Webhook ID shown after you add https://<host>/api/webhooks/paypal to the sandbox app
PAYPAL_WEBHOOK_ID=
# A sandbox business account used as a payee in the demo (for example, a replacement order's retailer stand-in)
PAYPAL_VENDOR_EMAIL=
# The sandbox personal account (Testing Tools > Sandbox Accounts), for the payment tests
SANDBOX_BUYER_EMAIL=
SANDBOX_BUYER_PASSWORD=

# Elastic Cloud Serverless: recall search (hybrid keyword and semantic). Unset, an in-app keyword search stands in.
ELASTIC_URL=
ELASTIC_API_KEY=
KIBANA_URL=

# Channel3 (trychannel3.com/developers): safe replacement products. Unset, owners are offered a refund instead.
CHANNEL3_API_KEY=

# KERNEL cloud browser: reads recall pages and firm recall sites. Unset, a plain fetch reads static pages.
KERNEL_API_KEY=

# Zapier MCP: the inbox bridge and notices
ZAPIER_MCP_URL=

# AG Studio licence key (AG Grid enterprise and AG Studio show a licence notice without it)
NEXT_PUBLIC_AG_STUDIO_LICENSE_KEY=

# Astropods hosted photo-verifier agent
ASTROPODS_AGENT_URL=
ASTROPODS_API_KEY=

# Render (render.com > Account settings > API keys): Render Workflows
RENDER_API_KEY=

# Error tracking (sentry.io > project > Client Keys). Unset, errors stay in the structured log only. Personal data is
# scrubbed before anything is sent. NEXT_PUBLIC_SENTRY_DSN turns on browser errors too (set at build time).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Outside checks: the shared secret a Render Workflow uses to file results
CHECKS_SECRET=
CHECKS_WORKFLOW_SLUG=

# Feature switches: force a fallback even when a key is set
FALLBACK_ELASTIC=false
FALLBACK_KERNEL=false
FALLBACK_ZAPIER=false
FALLBACK_ASTROPODS=false

# Encrypts where each payout goes, inside its payment plan. Falls back to CHECKS_SECRET when unset.
REMEDY_SECRET_KEY=
# Local only: lets "next start" use the development DATA_KEY. Never set this on a hosted copy.
# REMEDY_ALLOW_DEV_KEY=1
